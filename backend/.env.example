# Copy to .env and fill in for production. All keys are optional in dev
# (the prototype ships with offline/mock defaults).

CANDORIFY_ENVIRONMENT=development
CANDORIFY_SECRET_KEY=change-me-to-a-long-random-string
CANDORIFY_DATABASE_URL=sqlite:///./candorify.db

# Privacy
CANDORIFY_UPLOAD_RETENTION_DAYS=30

# Google Gemini AI (optional) — preferred provider for translation + email
# drafting. Get a FREE key (no credit card) at:
#   https://aistudio.google.com/app/apikey
# If unset, the app falls back to NLM/LibreTranslate/offline and fixed templates.
CANDORIFY_LLM_ENABLED=true
CANDORIFY_LLM_API_KEY=
CANDORIFY_LLM_MODEL=gemini-1.5-flash

# Translation fallback providers (set OFFLINE_ONLY=false to call real APIs)
CANDORIFY_TRANSLATION_OFFLINE_ONLY=true
CANDORIFY_NLM_BASE_URL=https://clinicaltables.nlm.nih.gov/api
CANDORIFY_LIBRETRANSLATE_URL=https://libretranslate.com/translate
CANDORIFY_LIBRETRANSLATE_API_KEY=

# Payments (Stripe test mode). Set MOCK_MODE=false to use real Stripe.
CANDORIFY_PAYMENTS_MOCK_MODE=true
CANDORIFY_STRIPE_SECRET_KEY=sk_test_xxx
CANDORIFY_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
CANDORIFY_STRIPE_PRICE_ID_PAID=price_xxx
CANDORIFY_STRIPE_WEBHOOK_SECRET=whsec_xxx
